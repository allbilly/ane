program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3510.2.1"}, {"coremlc-version", "3505.4.1"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<ios18>(tensor<fp16, [1,768,1,32]> x) {
        tensor<fp16, [1,768,1,1]> ln1_g = const()[name=string("ln1_g"), val=tensor<fp16, [1,768,1,1]>(BLOBFILE(path=string("@model_path/weights/packed.bin"), offset=uint64(8384)))];
        tensor<fp16, [1,768,1,1]> ln1_beta = const()[name=string("ln1_beta"), val=tensor<fp16, [1,768,1,1]>(BLOBFILE(path=string("@model_path/weights/packed.bin"), offset=uint64(6720)))];
        tensor<int32, [1]> ln1_ax = const()[name=string("ln1_ax"), val=tensor<int32, [1]>([1])];
        fp16 ln1_eps = const()[name=string("ln1_eps"), val=fp16(1e-05)];
        fp16 ln1_nhalf = const()[name=string("ln1_nhalf"), val=fp16(-0.5)];
        tensor<fp16, [768,768,1,1]> q_W = const()[name=string("q_W"), val=tensor<fp16, [768,768,1,1]>(BLOBFILE(path=string("@model_path/weights/packed.bin"), offset=uint64(2369600)))];
        tensor<fp16, [1,768,1,1]> q_b = const()[name=string("q_b"), val=tensor<fp16, [1,768,1,1]>(BLOBFILE(path=string("@model_path/weights/packed.bin"), offset=uint64(3392)))];
        tensor<fp16, [768,768,1,1]> k_W = const()[name=string("k_W"), val=tensor<fp16, [768,768,1,1]>(BLOBFILE(path=string("@model_path/weights/packed.bin"), offset=uint64(10048)))];
        tensor<fp16, [1,768,1,1]> k_b = const()[name=string("k_b"), val=tensor<fp16, [1,768,1,1]>(BLOBFILE(path=string("@model_path/weights/packed.bin"), offset=uint64(64)))];
        tensor<fp16, [768,768,1,1]> v_W = const()[name=string("v_W"), val=tensor<fp16, [768,768,1,1]>(BLOBFILE(path=string("@model_path/weights/packed.bin"), offset=uint64(3549376)))];
        tensor<fp16, [1,768,1,1]> v_b = const()[name=string("v_b"), val=tensor<fp16, [1,768,1,1]>(BLOBFILE(path=string("@model_path/weights/packed.bin"), offset=uint64(5056)))];
        tensor<int32, [4]> attn_rsh = const()[name=string("attn_rsh"), val=tensor<int32, [4]>([1,12,64,32])];
        tensor<int32, [4]> attn_pm = const()[name=string("attn_pm"), val=tensor<int32, [4]>([0,1,3,2])];
        fp16 attn_scv = const()[name=string("attn_scv"), val=fp16(0.125)];
        tensor<fp16, [1,1,32,32]> attn_mask = const()[name=string("attn_mask"), val=tensor<fp16, [1,1,32,32]>(BLOBFILE(path=string("@model_path/weights/packed.bin"), offset=uint64(4729152)))];
        tensor<int32, [4]> attn_osh = const()[name=string("attn_osh"), val=tensor<int32, [4]>([1,768,1,32])];
        tensor<fp16, [768,768,1,1]> proj_W = const()[name=string("proj_W"), val=tensor<fp16, [768,768,1,1]>(BLOBFILE(path=string("@model_path/weights/packed.bin"), offset=uint64(1189824)))];
        tensor<fp16, [1,768,1,1]> proj_b = const()[name=string("proj_b"), val=tensor<fp16, [1,768,1,1]>(BLOBFILE(path=string("@model_path/weights/packed.bin"), offset=uint64(1728)))];
        bool ln1_mean_kd = const()[name=string("ln1_mean_kd"), val=bool(true)];
        tensor<fp16, [1,1,1,32]> ln1_mean = reduce_mean(x=x, axes=ln1_ax, keep_dims=ln1_mean_kd)[name=string("ln1_mean")];
        tensor<fp16, [1,768,1,32]> ln1_cent = sub(x=x, y=ln1_mean)[name=string("ln1_cent")];
        tensor<fp16, [1,768,1,32]> ln1_sq = mul(x=ln1_cent, y=ln1_cent)[name=string("ln1_sq")];
        bool ln1_var_kd = const()[name=string("ln1_var_kd"), val=bool(true)];
        tensor<fp16, [1,1,1,32]> ln1_var = reduce_mean(x=ln1_sq, axes=ln1_ax, keep_dims=ln1_var_kd)[name=string("ln1_var")];
        tensor<fp16, [1,1,1,32]> ln1_veps = add(x=ln1_var, y=ln1_eps)[name=string("ln1_veps")];
        tensor<fp16, [1,1,1,32]> ln1_rstd = pow(x=ln1_veps, y=ln1_nhalf)[name=string("ln1_rstd")];
        tensor<fp16, [1,768,1,32]> ln1_norm = mul(x=ln1_cent, y=ln1_rstd)[name=string("ln1_norm")];
        tensor<fp16, [1,768,1,32]> ln1_scaled = mul(x=ln1_norm, y=ln1_g)[name=string("ln1_scaled")];
        tensor<fp16, [1,768,1,32]> ln1_out = add(x=ln1_scaled, y=ln1_beta)[name=string("ln1_out")];
        string q_conv_pt = const()[name=string("q_conv_pt"), val=string("valid")];
        tensor<int32, [2]> q_conv_st = const()[name=string("q_conv_st"), val=tensor<int32, [2]>([1,1])];
        tensor<int32, [4]> q_conv_pd = const()[name=string("q_conv_pd"), val=tensor<int32, [4]>([0,0,0,0])];
        tensor<int32, [2]> q_conv_dl = const()[name=string("q_conv_dl"), val=tensor<int32, [2]>([1,1])];
        int32 q_conv_gr = const()[name=string("q_conv_gr"), val=int32(1)];
        tensor<fp16, [1,768,1,32]> q_conv = conv(dilations=q_conv_dl, groups=q_conv_gr, pad=q_conv_pd, pad_type=q_conv_pt, strides=q_conv_st, weight=q_W, x=ln1_out)[name=string("q_conv")];
        string k_conv_pt = const()[name=string("k_conv_pt"), val=string("valid")];
        tensor<int32, [2]> k_conv_st = const()[name=string("k_conv_st"), val=tensor<int32, [2]>([1,1])];
        tensor<int32, [4]> k_conv_pd = const()[name=string("k_conv_pd"), val=tensor<int32, [4]>([0,0,0,0])];
        tensor<int32, [2]> k_conv_dl = const()[name=string("k_conv_dl"), val=tensor<int32, [2]>([1,1])];
        int32 k_conv_gr = const()[name=string("k_conv_gr"), val=int32(1)];
        tensor<fp16, [1,768,1,32]> k_conv = conv(dilations=k_conv_dl, groups=k_conv_gr, pad=k_conv_pd, pad_type=k_conv_pt, strides=k_conv_st, weight=k_W, x=ln1_out)[name=string("k_conv")];
        string v_conv_pt = const()[name=string("v_conv_pt"), val=string("valid")];
        tensor<int32, [2]> v_conv_st = const()[name=string("v_conv_st"), val=tensor<int32, [2]>([1,1])];
        tensor<int32, [4]> v_conv_pd = const()[name=string("v_conv_pd"), val=tensor<int32, [4]>([0,0,0,0])];
        tensor<int32, [2]> v_conv_dl = const()[name=string("v_conv_dl"), val=tensor<int32, [2]>([1,1])];
        int32 v_conv_gr = const()[name=string("v_conv_gr"), val=int32(1)];
        tensor<fp16, [1,768,1,32]> v_conv = conv(dilations=v_conv_dl, groups=v_conv_gr, pad=v_conv_pd, pad_type=v_conv_pt, strides=v_conv_st, weight=v_W, x=ln1_out)[name=string("v_conv")];
        tensor<fp16, [1,768,1,32]> q_out = add(x=q_conv, y=q_b)[name=string("q_out")];
        tensor<fp16, [1,768,1,32]> k_cache = add(x=k_conv, y=k_b)[name=string("k_cache")];
        tensor<fp16, [1,768,1,32]> v_cache = add(x=v_conv, y=v_b)[name=string("v_cache")];
        tensor<fp16, [1,12,64,32]> attn_qr = reshape(shape=attn_rsh, x=q_out)[name=string("attn_qr")];
        tensor<fp16, [1,12,64,32]> attn_kr = reshape(shape=attn_rsh, x=k_cache)[name=string("attn_kr")];
        tensor<fp16, [1,12,64,32]> attn_vr = reshape(shape=attn_rsh, x=v_cache)[name=string("attn_vr")];
        tensor<fp16, [1,12,32,64]> attn_q = transpose(perm=attn_pm, x=attn_qr)[name=string("attn_q")];
        tensor<fp16, [1,12,32,64]> attn_k = transpose(perm=attn_pm, x=attn_kr)[name=string("attn_k")];
        tensor<fp16, [1,12,32,64]> attn_v = transpose(perm=attn_pm, x=attn_vr)[name=string("attn_v")];
        bool attn_sc_tx = const()[name=string("attn_sc_tx"), val=bool(false)];
        bool attn_sc_ty = const()[name=string("attn_sc_ty"), val=bool(true)];
        tensor<fp16, [1,12,32,32]> attn_sc = matmul(transpose_x=attn_sc_tx, transpose_y=attn_sc_ty, x=attn_q, y=attn_k)[name=string("attn_sc")];
        tensor<fp16, [1,12,32,32]> attn_scs = mul(x=attn_sc, y=attn_scv)[name=string("attn_scs")];
        tensor<fp16, [1,12,32,32]> attn_masked = add(x=attn_scs, y=attn_mask)[name=string("attn_masked")];
        int32 attn_attn_ax = const()[name=string("attn_attn_ax"), val=int32(-1)];
        tensor<fp16, [1,12,32,32]> attn_attn = softmax(axis=attn_attn_ax, x=attn_masked)[name=string("attn_attn")];
        bool attn_ctx_tx = const()[name=string("attn_ctx_tx"), val=bool(false)];
        bool attn_ctx_ty = const()[name=string("attn_ctx_ty"), val=bool(false)];
        tensor<fp16, [1,12,32,64]> attn_ctx = matmul(transpose_x=attn_ctx_tx, transpose_y=attn_ctx_ty, x=attn_attn, y=attn_v)[name=string("attn_ctx")];
        tensor<fp16, [1,12,64,32]> attn_ctxt = transpose(perm=attn_pm, x=attn_ctx)[name=string("attn_ctxt")];
        tensor<fp16, [1,768,1,32]> attn_out = reshape(shape=attn_osh, x=attn_ctxt)[name=string("attn_out")];
        string proj_conv_pt = const()[name=string("proj_conv_pt"), val=string("valid")];
        tensor<int32, [2]> proj_conv_st = const()[name=string("proj_conv_st"), val=tensor<int32, [2]>([1,1])];
        tensor<int32, [4]> proj_conv_pd = const()[name=string("proj_conv_pd"), val=tensor<int32, [4]>([0,0,0,0])];
        tensor<int32, [2]> proj_conv_dl = const()[name=string("proj_conv_dl"), val=tensor<int32, [2]>([1,1])];
        int32 proj_conv_gr = const()[name=string("proj_conv_gr"), val=int32(1)];
        tensor<fp16, [1,768,1,32]> proj_conv = conv(dilations=proj_conv_dl, groups=proj_conv_gr, pad=proj_conv_pd, pad_type=proj_conv_pt, strides=proj_conv_st, weight=proj_W, x=attn_out)[name=string("proj_conv")];
        tensor<fp16, [1,768,1,32]> proj_out = add(x=proj_conv, y=proj_b)[name=string("proj_out")];
        tensor<fp16, [1,768,1,32]> hidden = add(x=x, y=proj_out)[name=string("hidden")];
    } -> (hidden, k_cache, v_cache);
}
