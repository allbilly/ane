program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3510.2.1"}, {"coremlc-version", "3505.4.1"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<ios18>(tensor<fp16, [1,768,1,32]> x) {
        tensor<fp16, [1,768,1,1]> lnf_g = const()[name=string("lnf_g"), val=tensor<fp16, [1,768,1,1]>(BLOBFILE(path=string("@model_path/weights/packed.bin"), offset=uint64(1728)))];
        tensor<fp16, [1,768,1,1]> lnf_beta = const()[name=string("lnf_beta"), val=tensor<fp16, [1,768,1,1]>(BLOBFILE(path=string("@model_path/weights/packed.bin"), offset=uint64(64)))];
        tensor<int32, [1]> lnf_ax = const()[name=string("lnf_ax"), val=tensor<int32, [1]>([1])];
        fp16 lnf_eps = const()[name=string("lnf_eps"), val=fp16(1e-05)];
        fp16 lnf_nhalf = const()[name=string("lnf_nhalf"), val=fp16(-0.5)];
        bool lnf_mean_kd = const()[name=string("lnf_mean_kd"), val=bool(true)];
        tensor<fp16, [1,1,1,32]> lnf_mean = reduce_mean(x=x, axes=lnf_ax, keep_dims=lnf_mean_kd)[name=string("lnf_mean")];
        tensor<fp16, [1,768,1,32]> lnf_cent = sub(x=x, y=lnf_mean)[name=string("lnf_cent")];
        tensor<fp16, [1,768,1,32]> lnf_sq = mul(x=lnf_cent, y=lnf_cent)[name=string("lnf_sq")];
        bool lnf_var_kd = const()[name=string("lnf_var_kd"), val=bool(true)];
        tensor<fp16, [1,1,1,32]> lnf_var = reduce_mean(x=lnf_sq, axes=lnf_ax, keep_dims=lnf_var_kd)[name=string("lnf_var")];
        tensor<fp16, [1,1,1,32]> lnf_veps = add(x=lnf_var, y=lnf_eps)[name=string("lnf_veps")];
        tensor<fp16, [1,1,1,32]> lnf_rstd = pow(x=lnf_veps, y=lnf_nhalf)[name=string("lnf_rstd")];
        tensor<fp16, [1,768,1,32]> lnf_norm = mul(x=lnf_cent, y=lnf_rstd)[name=string("lnf_norm")];
        tensor<fp16, [1,768,1,32]> lnf_scaled = mul(x=lnf_norm, y=lnf_g)[name=string("lnf_scaled")];
        tensor<fp16, [1,768,1,32]> hidden = add(x=lnf_scaled, y=lnf_beta)[name=string("hidden")];
    } -> (hidden);
}
