program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3520.4.1"}, {"coremlc-version", "3520.5.1"}})]
{
    func main<ios18>(tensor<fp16, [1, 12, 32, 64]> t1, tensor<fp16, [1, 12, 32, 32]> t0) {
        tensor<int32, [4]> t2_p = const()[name = string("t2_p"), val = tensor<int32, [4]>([0, 1, 3, 2])];
        tensor<fp16, [1, 12, 64, 32]> t2 = transpose(perm = t2_p, x = t1)[name = string("t2")];
        tensor<fp16, [1, 12, 64, 32]> t3 = matmul(transpose_x = bool(false), transpose_y = bool(false), x = t2, y = t0)[name = string("t3")];
    } -> (t3);
}
