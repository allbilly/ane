program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3520.4.1"}, {"coremlc-version", "3520.5.1"}})]
{
    func main<ios18>(tensor<fp16, [1, 1, 32, 3072]> t1, tensor<fp16, [1, 1, 32, 3072]> t23) {
        tensor<fp16, []> t0 = const()[name = string("t0"), val = tensor<fp16, []>(BLOBFILE(path = string("@model_path/weights.bin"), offset = uint64(64)))];
        tensor<fp16, [1, 1, 32, 3072]> t2 = mul(x = t1, y = t1)[name = string("t2")];
        tensor<fp16, [1, 1, 32, 3072]> t3 = mul(x = t2, y = t1)[name = string("t3")];
        fp16 t4_k = const()[name = string("t4_k"), val = fp16(0x1.6e40000000000p-5)];
        tensor<fp16, [1, 1, 32, 3072]> t4 = mul(x = t3, y = t4_k)[name = string("t4")];
        tensor<fp16, [1, 1, 32, 3072]> t5 = add(x = t1, y = t4)[name = string("t5")];
        fp16 t6_k = const()[name = string("t6_k"), val = fp16(0x1.9880000000000p-1)];
        tensor<fp16, [1, 1, 32, 3072]> t6 = mul(x = t5, y = t6_k)[name = string("t6")];
        tensor<fp16, [1, 1, 32, 3072]> t7 = tanh(x = t6)[name = string("t7")];
        tensor<fp16, [1, 1, 32, 3072]> t8 = mul(x = t7, y = t7)[name = string("t8")];
        fp16 t9_k = const()[name = string("t9_k"), val = fp16(-0x1.0000000000000p+0)];
        tensor<fp16, [1, 1, 32, 3072]> t9 = mul(x = t8, y = t9_k)[name = string("t9")];
        tensor<fp16, [1, 1, 32, 3072]> t10 = add(x = t9, y = t0)[name = string("t10")];
        tensor<fp16, []> t11 = const()[name = string("t11"), val = tensor<fp16, []>(BLOBFILE(path = string("@model_path/weights.bin"), offset = uint64(130)))];
        tensor<fp16, [1, 1, 32, 3072]> t12 = mul(x = t1, y = t1)[name = string("t12")];
        fp16 t13_k = const()[name = string("t13_k"), val = fp16(0x1.12c0000000000p-3)];
        tensor<fp16, [1, 1, 32, 3072]> t13 = mul(x = t12, y = t13_k)[name = string("t13")];
        tensor<fp16, [1, 1, 32, 3072]> t14 = add(x = t13, y = t11)[name = string("t14")];
        fp16 t15_k = const()[name = string("t15_k"), val = fp16(0x1.9880000000000p-1)];
        tensor<fp16, [1, 1, 32, 3072]> t15 = mul(x = t14, y = t15_k)[name = string("t15")];
        tensor<fp16, [1, 1, 32, 3072]> t16 = mul(x = t15, y = t10)[name = string("t16")];
        tensor<fp16, [1, 1, 32, 3072]> t17 = mul(x = t1, y = t16)[name = string("t17")];
        fp16 t18_k = const()[name = string("t18_k"), val = fp16(0x1.0000000000000p-1)];
        tensor<fp16, [1, 1, 32, 3072]> t18 = mul(x = t17, y = t18_k)[name = string("t18")];
        tensor<fp16, []> t19 = const()[name = string("t19"), val = tensor<fp16, []>(BLOBFILE(path = string("@model_path/weights.bin"), offset = uint64(196)))];
        tensor<fp16, [1, 1, 32, 3072]> t20 = add(x = t7, y = t19)[name = string("t20")];
        fp16 t21_k = const()[name = string("t21_k"), val = fp16(0x1.0000000000000p-1)];
        tensor<fp16, [1, 1, 32, 3072]> t21 = mul(x = t20, y = t21_k)[name = string("t21")];
        tensor<fp16, [1, 1, 32, 3072]> t22 = add(x = t21, y = t18)[name = string("t22")];
        tensor<fp16, [1, 1, 32, 3072]> t24 = mul(x = t23, y = t22)[name = string("t24")];
    } -> (t24);
}
