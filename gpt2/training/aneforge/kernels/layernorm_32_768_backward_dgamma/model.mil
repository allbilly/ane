program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3520.4.1"}, {"coremlc-version", "3520.5.1"}})]
{
    func main<ios18>(tensor<fp16, [1, 1, 32, 768]> t2, tensor<fp16, [1, 1, 32, 768]> t0) {
        tensor<fp16, []> t1 = const()[name = string("t1"), val = tensor<fp16, []>(BLOBFILE(path = string("@model_path/weights.bin"), offset = uint64(64)))];
        tensor<int32, [1]> t3_ax = const()[name = string("t3_ax"), val = tensor<int32, [1]>([3])];
        bool t3_kd = const()[name = string("t3_kd"), val = bool(true)];
        tensor<fp16, [1, 1, 32, 1]> t3 = reduce_mean(axes = t3_ax, keep_dims = t3_kd, x = t2)[name = string("t3")];
        tensor<fp16, [1, 1, 32, 768]> t4 = sub(x = t2, y = t3)[name = string("t4")];
        tensor<fp16, [1, 1, 32, 768]> t5 = mul(x = t4, y = t4)[name = string("t5")];
        tensor<int32, [1]> t6_ax = const()[name = string("t6_ax"), val = tensor<int32, [1]>([3])];
        bool t6_kd = const()[name = string("t6_kd"), val = bool(true)];
        tensor<fp16, [1, 1, 32, 1]> t6 = reduce_mean(axes = t6_ax, keep_dims = t6_kd, x = t5)[name = string("t6")];
        tensor<fp16, [1, 1, 32, 1]> t7 = add(x = t6, y = t1)[name = string("t7")];
        tensor<fp16, [1, 1, 32, 1]> t8 = rsqrt(epsilon = fp16(0x0.0p+0), x = t7)[name = string("t8")];
        tensor<fp16, [1, 1, 32, 768]> t9 = mul(x = t4, y = t8)[name = string("t9")];
        tensor<fp16, [1, 1, 32, 768]> t10 = mul(x = t9, y = t0)[name = string("t10")];
        tensor<int32, [1]> t11_ax = const()[name = string("t11_ax"), val = tensor<int32, [1]>([2])];
        bool t11_kd = const()[name = string("t11_kd"), val = bool(true)];
        tensor<fp16, [1, 1, 1, 768]> t11 = reduce_sum(axes = t11_ax, keep_dims = t11_kd, x = t10)[name = string("t11")];
    } -> (t11);
}
