program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3520.4.1"}, {"coremlc-version", "3520.5.1"}})]
{
    func main<ios18>(tensor<fp16, [1, 1, 32, 3072]> t0) {
        tensor<int32, [1]> t1_ax = const()[name = string("t1_ax"), val = tensor<int32, [1]>([2])];
        bool t1_kd = const()[name = string("t1_kd"), val = bool(true)];
        tensor<fp16, [1, 1, 1, 3072]> t1 = reduce_sum(axes = t1_ax, keep_dims = t1_kd, x = t0)[name = string("t1")];
    } -> (t1);
}
