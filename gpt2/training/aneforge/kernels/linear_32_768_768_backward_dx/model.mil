program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3520.4.1"}, {"coremlc-version", "3520.5.1"}})]
{
    func main<ios18>(tensor<fp16, [1, 1, 32, 768]> t2, tensor<fp16, [1, 1, 768, 768]> t0) {
        tensor<int32, [4]> t1_p = const()[name = string("t1_p"), val = tensor<int32, [4]>([0, 1, 3, 2])];
        tensor<fp16, [1, 1, 768, 768]> t1 = transpose(perm = t1_p, x = t0)[name = string("t1")];
        tensor<fp16, [1, 1, 32, 768]> t3 = matmul(transpose_x = bool(false), transpose_y = bool(false), x = t2, y = t1)[name = string("t3")];
    } -> (t3);
}
