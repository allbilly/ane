program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3520.4.1"}, {"coremlc-version", "3520.5.1"}})]
{
    func main<ios18>(tensor<fp16, [1, 12, 32, 32]> t0, tensor<fp16, [1, 12, 32, 32]> t1) {
        tensor<fp16, [1, 12, 32, 32]> t2 = mul(x = t1, y = t0)[name = string("t2")];
        tensor<int32, [1]> t3_ax = const()[name = string("t3_ax"), val = tensor<int32, [1]>([3])];
        bool t3_kd = const()[name = string("t3_kd"), val = bool(true)];
        tensor<fp16, [1, 12, 32, 1]> t3 = reduce_sum(axes = t3_ax, keep_dims = t3_kd, x = t2)[name = string("t3")];
        tensor<fp16, [1, 12, 32, 32]> t4 = sub(x = t1, y = t3)[name = string("t4")];
        tensor<fp16, [1, 12, 32, 32]> t5 = mul(x = t0, y = t4)[name = string("t5")];
        fp16 t6_k = const()[name = string("t6_k"), val = fp16(0x1.0000000000000p-3)];
        tensor<fp16, [1, 12, 32, 32]> t6 = mul(x = t5, y = t6_k)[name = string("t6")];
    } -> (t6);
}
