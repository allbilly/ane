    func main<ios18>(tensor<fp16, [1,1,32,3072]> input00, tensor<fp16, [1,1,3072,768]> input01, tensor<fp16, [1,1,1,768]> input02) {
        bool n0001_tx = const()[name=string("n0001_tx"), val=bool(false)];
